<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <InvariantGlobalization>true</InvariantGlobalization>
    <RootNamespace>RegenChamber</RootNamespace>
  </PropertyGroup>

  <PropertyGroup>
    <!-- Local PicoGK checkout (v2.3.0). Only its bin/obj are written by this build. -->
    <PicoGKDir>D:\Research-Software\repos\leap71\PicoGK</PicoGKDir>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="$(PicoGKDir)\PicoGK.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- PicoGK native runtime (OpenVDB based) and its DLL dependencies -->
    <None Include="$(PicoGKDir)\native\win-x64\*.dll"
          Link="%(Filename)%(Extension)"
          CopyToOutputDirectory="PreserveNewest"
          Visible="false" />
  </ItemGroup>

</Project>
